# EcoTrainer Studio - Environment Configuration
# Copy this file to .env and fill in your actual values

# ==================================
# DATABASE CONFIGURATION
# ==================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecotrainer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ==================================
# APPLICATION SETTINGS
# ==================================
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-minimum-32-characters-change-this
PROJECT_NAME=EcoTrainer Studio
VERSION=2.0.0

# ==================================
# URLs
# ==================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
API_V1_STR=/api/v1

# ==================================
# PHASE 2: CARBON-AWARE SCHEDULING
# ==================================
# ElectricityMap API (https://www.electricitymap.org/api)
# Sign up for a free API key to access real carbon intensity data
ELECTRICITY_MAP_API_KEY=your-electricitymap-api-key-here
ELECTRICITY_MAP_REGION=AU-VIC

# Carbon scheduling thresholds (gCO2/kWh)
CARBON_THRESHOLD_LOW=300
CARBON_THRESHOLD_HIGH=600

# ==================================
# INSTAGRAM OAUTH
# ==================================
# Get these from Meta Developers (https://developers.facebook.com/)
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/accounts/instagram/callback
# Optional: For development mode when /me/accounts returns empty
INSTAGRAM_FALLBACK_PAGE_ID=your-facebook-page-id

# ==================================
# PHASE 3: AI CONTENT GENERATION
# ==================================
# OpenAI API (https://platform.openai.com/api-keys)
# Required for content generation features
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# ==================================
# REDIS (OPTIONAL)
# ==================================
REDIS_URL=redis://localhost:6379/0

# ==================================
# SCHEDULER SETTINGS
# ==================================
# How often to update carbon forecasts (hours)
FORECAST_UPDATE_INTERVAL_HOURS=6

# How often to check for pending jobs (minutes)
JOB_CHECK_INTERVAL_MINUTES=30

# Enable/disable automatic job scheduling
SCHEDULER_ENABLED=true

# ==================================
# TESTING
# ==================================
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecotrainer_test
