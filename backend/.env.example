# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecotrainer
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Application Settings
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development

# CORS Settings
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Instagram API Configuration
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback
INSTAGRAM_FALLBACK_PAGE_ID=your_facebook_page_id

# ElectricityMap API (Phase 2)
ELECTRICITY_MAP_API_KEY=your_electricity_map_api_key
ELECTRICITY_MAP_REGION=AU-VIC

# OpenAI API (Phase 2)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# AWS Configuration (for production deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=ecotrainer-media

# Scheduler Settings
SCHEDULER_TIMEZONE=Australia/Melbourne
JOB_EXECUTION_INTERVAL_MINUTES=30
CARBON_FORECAST_UPDATE_HOURS=6

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
